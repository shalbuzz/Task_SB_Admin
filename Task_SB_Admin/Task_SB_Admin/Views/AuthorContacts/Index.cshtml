@model List<Task_SB_Admin.ViewModels.AuthorContact.AuthorContactVM>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                 Id
            </th>
            <th>
               AuthorId
            </th>
            <th>
                AuthorName
            </th>
            <th>
                Email
            </th>
            <th>
               Phone
            </th>
            <th>
               Address
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AuthorId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AuthorName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-controller="AuthorContacts" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-controller="AuthorContacts" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    <a class="btn btn-sm btn-info" asp-controller="AuthorContacts" asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
        </tr>
}
    </tbody>
</table>
@section Scripts {
    <script>
        $(function () {
            var success = '@TempData["Success"]';
            var error = '@TempData["Error"]';

            if (success) {
                toastr.success(success);
            }

            if (error) {
                toastr.error(error);
            }
        });
    </script>
}
